# Set in your shell; this app does not implicitly load .env files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_BUDGET_USD=0.50
AI_INPUT_USD_PER_MILLION=0.40
AI_OUTPUT_USD_PER_MILLION=1.60
HOST=127.0.0.1
PORT=8000
# Required when binding to a public/network interface. Set a random 16+ character password.
SIGNALDESK_USERNAME=reviewer
SIGNALDESK_PASSWORD=
# On Render, this is set by render.yaml to the persistent disk path.
# SIGNALDESK_DB=var/signaldesk.sqlite
